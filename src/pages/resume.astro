---
import { getCollection } from "astro:content";
import { 
    SKILLS, 
    RESUME_SUMMARY, 
    PROFESSIONAL_EXPERIENCE, 
    EDUCATION_DATA 
} from "../data";

const projects = await getCollection("projects");
const RESUME_PROJECTS = projects.slice(0, 2).map((p) => ({
	id: p.slug,
	title: p.data.title,
	impact: p.data.impact,
	description: p.data.description || "",
	tags: p.data.tags,
}));

const groupedSkills = SKILLS.reduce(
	(acc, skill) => {
		if (!acc[skill.category]) acc[skill.category] = [];
		acc[skill.category].push(skill.name);
		return acc;
	},
	{} as Record<string, string[]>,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Resume | Dallington</title>
    <meta
      name="description"
      content="Professional Resume of Dallington - Senior Fullstack Engineer"
    />
    <style>
      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: white !important;
          color: black !important;
        }
        .min-h-screen {
          padding: 0 !important;
          pt: 0 !important;
          background: white !important;
        }
        .bg-white,
        .print-bg-white {
          background: white !important;
          border: none !important;
          box-shadow: none !important;
        }
        .max-w-5xl {
          max-w: 100% !important;
        }
        header {
          background: #f8fafc !important;
          color: black !important;
        }
        aside {
          background: #f8fafc !important;
          border-left: 1px solid #e2e8f0 !important;
        }
        .text-slate-600,
        .dark\:text-slate-400 {
          color: #475569 !important;
        }
        .text-slate-900,
        .dark\:text-white {
          color: black !important;
        }
        .text-blue-600,
        .dark\:text-blue-500 {
          color: #2563eb !important;
        }
      }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-[#FDFDFD] text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900"
  >
    <div class="max-w-5xl mx-auto py-20 px-6">
      {/* Top Utility Bar */}
      <div class="flex justify-between items-center mb-8 no-print">
        <div
          class="flex items-center gap-2 text-slate-500 text-xs font-bold uppercase tracking-widest"
        >
          <div class="w-2 h-2 rounded-full bg-blue-600"></div>
          Official Professional Record
        </div>
        <button
          onclick="window.print()"
          class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white rounded-lg font-bold text-sm hover:bg-blue-700 transition-all shadow-md shadow-blue-100 active:scale-95 cursor-pointer"
        >
          Download PDF
        </button>
      </div>

      {/* Main Resume Document */}
      <div
        class="bg-white print-bg-white border border-slate-200 shadow-sm rounded-sm overflow-hidden"
      >
        {/* 1. Header Section */}
        <header class="p-10 md:p-14 border-b border-slate-100 bg-slate-50/30">
          <div
            class="flex flex-col md:flex-row justify-between items-start gap-8"
          >
            <div class="max-w-2xl">
              <h1
                class="text-5xl font-black text-slate-900 tracking-tight mb-3"
              >
                Dallington
              </h1>
              <h2
                class="text-2xl font-bold text-blue-600 mb-6 uppercase tracking-tight"
              >
                Senior Fullstack Engineer & Product Architect
              </h2>
              <p class="text-lg text-slate-600 leading-relaxed font-normal">
                {RESUME_SUMMARY}
              </p>
            </div>

            <div
              class="flex flex-col gap-4 text-sm font-medium text-slate-500 w-full md:w-auto"
            >
              <div class="flex items-center gap-3">London, UK / Remote</div>
              <div class="flex items-center gap-3">
                Available for Senior Roles
              </div>
              <div class="flex items-center gap-3">dallington.dev</div>
              <div class="h-px bg-slate-200 my-2"></div>
              <div class="flex gap-4">
                <a
                  href="#"
                  class="hover:text-blue-600 transition-colors"
                  title="LinkedIn"
                >
                  LinkedIn
                </a>
                <a
                  href="#"
                  class="hover:text-blue-600 transition-colors"
                  title="GitHub"
                >
                  GitHub
                </a>
                <a
                  href="mailto:hello@dallington.dev"
                  class="hover:text-blue-600 transition-colors"
                  title="Email"
                >
                  Email
                </a>
              </div>
            </div>
          </div>
        </header>

        <div class="grid md:grid-cols-[1fr_300px]">
          {/* Left Column: Narrative (Experience & Projects) */}
          <main class="p-10 md:p-14 space-y-16 border-r border-slate-100">
            {/* Experience */}
            <section>
              <div class="flex items-center gap-4 mb-10">
                <h3
                  class="text-xs font-black uppercase tracking-[0.2em] text-blue-600 whitespace-nowrap"
                >
                  Professional Experience
                </h3>
                <div class="h-px bg-slate-100 w-full"></div>
              </div>

              <div class="space-y-14">
                {
                  PROFESSIONAL_EXPERIENCE.map((exp) => (
                    <div class="relative">
                      <div class="flex flex-col sm:flex-row justify-between items-start gap-2 mb-6">
                        <div>
                          <h4 class="text-xl font-black text-slate-900 leading-none mb-2">
                            {exp.role}
                          </h4>
                          <div class="flex items-center gap-2">
                            <span class="text-blue-600 font-bold text-sm tracking-tight">
                              {exp.company}
                            </span>
                          </div>
                        </div>
                        <span class="px-3 py-1 bg-slate-100 text-slate-500 text-[10px] font-black uppercase tracking-widest rounded-full">
                          {exp.period}
                        </span>
                      </div>

                      <ul class="space-y-4 mb-8">
                        {exp.description.map((point) => (
                          <li class="text-[15px] text-slate-600 leading-relaxed flex gap-4">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-200 mt-2 flex-shrink-0" />
                            {point}
                          </li>
                        ))}
                      </ul>

                      <div class="flex flex-wrap gap-2">
                        {exp.skills.map((s) => (
                          <span class="px-2.5 py-1 bg-slate-50 text-slate-400 text-[10px] font-bold uppercase tracking-tight border border-slate-100 rounded">
                            {s}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </section>

            {/* Key Project Outcomes */}
            <section>
              <div class="flex items-center gap-4 mb-10">
                <h3
                  class="text-xs font-black uppercase tracking-[0.2em] text-blue-600 whitespace-nowrap"
                >
                  Selected Product Impact
                </h3>
                <div class="h-px bg-slate-100 w-full"></div>
              </div>

              <div class="grid sm:grid-cols-2 gap-8">
                {
                  RESUME_PROJECTS.map((project) => (
                    <div class="p-8 border border-slate-100 rounded-lg hover:border-blue-200 transition-colors group">
                      <h4 class="font-black text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">
                        {project.title}
                      </h4>
                      <div class="text-[11px] font-bold text-blue-600 uppercase tracking-tight mb-4">
                        {project.impact}
                      </div>
                      <p class="text-sm text-slate-500 leading-relaxed font-normal mb-6">
                        {project.description}
                      </p>
                      <div class="flex flex-wrap gap-1.5">
                        {project.tags.slice(0, 3).map((t) => (
                          <span class="text-[9px] font-black text-slate-300 uppercase">
                            #{t}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </section>
          </main>

          {/* Right Column: Metadata (Skills, Education, Certs) */}
          <aside class="p-10 md:p-12 bg-slate-50/50 space-y-14">
            {/* Skills Sidebar */}
            <section>
              <h3
                class="text-xs font-black uppercase tracking-[0.2em] text-blue-600 mb-8"
              >
                Expertise
              </h3>
              <div class="space-y-10">
                {
                  Object.entries(groupedSkills).map(([category, items]) => (
                    <div>
                      <h4 class="text-[10px] font-black uppercase text-slate-400 mb-4 tracking-[0.15em]">
                        {category}
                      </h4>
                      <div class="flex flex-wrap gap-x-3 gap-y-2">
                        {items?.map((item) => (
                          <span class="text-sm font-bold text-slate-700">
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </section>

            {/* Education Sidebar */}
            <section>
              <h3
                class="text-xs font-black uppercase tracking-[0.2em] text-blue-600 mb-8"
              >
                Education
              </h3>
              <div class="space-y-8">
                {
                  EDUCATION_DATA.map((edu) => (
                    <div>
                      <div class="text-sm font-black text-slate-900 mb-1">
                        {edu.degree}
                      </div>
                      <div class="text-xs text-slate-500 font-bold mb-2">
                        {edu.institution}
                      </div>
                      <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                        {edu.period}
                      </div>
                    </div>
                  ))
                }
              </div>
            </section>

            {/* Footer */}
            <div
              class="mt-12 text-slate-400 text-[10px] font-bold uppercase tracking-widest"
            >
              © 2024 Dallington<br />Fullstack Professional
            </div>
          </aside>
        </div>
      </div>
    </div>
  </body>
</html>
