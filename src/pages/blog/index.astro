---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PostListItem } from '../../components/react/PostListItem';
import { getCollection } from 'astro:content';
import { Search } from 'lucide-react';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).map(p => ({id: p.slug, ...p.data}));
---

<BaseLayout title="Blog | Dallington">
    <section class="pt-32 pb-24 px-6 min-h-screen bg-white dark:bg-[#0A0A0A]">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-24">
          <div class="max-w-3xl">
            <div class="hidden text-[var(--accent)] mono mb-4 group-[.recruiter-mode]:hidden">// QUERYING_JOURNAL_ENTRIES</div>
            <h1 class="text-6xl md:text-[8rem] font-black text-gray-900 dark:text-white uppercase tracking-tighter leading-[0.8]">
              The Engineering Blog
            </h1>
          </div>
          {/* Search functionality would require hydration. For now static list. */}
        </div>
        <div class="border-t border-gray-200 dark:border-[#1A1A1A]">
          {sortedPosts.length > 0 ? sortedPosts.map((post) => (
            <PostListItem client:visible post={post} />
          )) : (
            <div class="py-24 text-center">
              <p class="text-gray-500 mono text-sm tracking-widest uppercase">404_ENTRIES_NOT_FOUND</p>
            </div>
          )}
        </div>
      </div>
    </section>
</BaseLayout>
