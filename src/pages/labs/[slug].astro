---
export const prerender = true;
import { getCollection } from "astro:content";
import { LabDetail } from "@components/react/LabDetail";
import { SystemDesignPlayground } from "@components/react/SystemDesignPlayground";
import BaseLayout from "@layouts/BaseLayout.astro";
import { FlaskConical } from "lucide-react";

export async function getStaticPaths() {
	const labs = await getCollection("labs");
	return labs.map((lab) => ({
		params: { slug: lab.slug },
		props: { lab },
	}));
}

const { lab } = Astro.props;
---

<BaseLayout title={lab.data.title}>
  <LabDetail client:load lab={lab}>
    {
      lab.data.component === "SystemDesignPlayground" ? (
        <SystemDesignPlayground client:only="react" />
      ) : (
        <div class="p-24 border-2 border-dashed border-gray-200 dark:border-gray-800 text-center">
          <div class="flex flex-col items-center gap-4">
            <FlaskConical size={48} class="text-gray-300" />
            <p class="mono text-xs text-gray-500 uppercase tracking-widest">
              Environment Offline
            </p>
          </div>
        </div>
      )
    }
  </LabDetail>
</BaseLayout>
